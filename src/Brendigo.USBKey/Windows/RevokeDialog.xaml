<Window x:Class="Brendigo.USBKey.Windows.RevokeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Opoziv USB ključa — Brendigo USB Key"
        Icon="/Assets/brendigo-usb-key.ico"
        Width="580" Height="445" MinWidth="520" MinHeight="415"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        FontFamily="Segoe UI" Background="#F2F6FA">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Background="#0B2D5C" Padding="26,21">
      <StackPanel Orientation="Horizontal">
        <Image Source="/Assets/brendigo-usb-key.ico"
               Width="55" Height="55" Margin="0,0,15,0"
               AutomationProperties.Name="Brendigo USB Key sigurnosna ikona"/>
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="Opoziv registriranog USB-a" FontSize="23"
                     FontWeight="Bold" Foreground="White"/>
          <TextBlock Text="Sigurnosna potvrda" FontSize="13"
                     Margin="0,5,0,0" Foreground="#79E6DE"/>
        </StackPanel>
      </StackPanel>
    </Border>

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="26,22,26,16">
        <Border Background="White" BorderBrush="#D5E6F4" BorderThickness="1"
                CornerRadius="12" Padding="18">
          <StackPanel>
            <TextBlock Text="Odabrani USB ključ" Foreground="#597392"
                       FontWeight="SemiBold" FontSize="12" Margin="0,0,0,8"/>
            <TextBlock x:Name="KeyNameText" TextWrapping="Wrap" FontSize="20"
                       FontWeight="Bold" Foreground="#0B2D5C"/>
          </StackPanel>
        </Border>

        <Border Background="#FFF2DE" BorderBrush="#F2D19D" BorderThickness="1"
                CornerRadius="12" Padding="15" Margin="0,15,0,13">
          <TextBlock TextWrapping="Wrap" Foreground="#82551F"
                     Text="Opoziv uklanja povjerenje u odabrani USB na ovom računalu. Podaci na samom sticku neće se automatski izbrisati. Windows lozinka i Hello ostaju dostupni."/>
        </Border>

        <CheckBox x:Name="AcknowledgeCheck" FontSize="14"
                  Checked="Acknowledge_Changed" Unchecked="Acknowledge_Changed"
                  AutomationProperties.Name="Potvrđujem opoziv USB ključa"
                  Content="Razumijem da će ključ prestati biti prepoznat."
                  Margin="2,3,0,0" TextOptions.TextFormattingMode="Display"/>
      </StackPanel>
    </ScrollViewer>

    <Border Grid.Row="2" Background="White" BorderThickness="0,1,0,0"
            BorderBrush="#D5E6F4" Padding="24,15">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="Odustani" IsCancel="True" Width="120"
                Style="{StaticResource SecondaryButton}" Margin="0,0,10,0"/>
        <Button x:Name="ConfirmRevokeButton" Content="Opozovi USB"
                IsDefault="True" IsEnabled="False"
                Width="175" Style="{StaticResource DangerButton}"
                Click="ConfirmRevoke_Click"/>
      </StackPanel>
    </Border>
  </Grid>
</Window>